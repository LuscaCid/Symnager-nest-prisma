# Copie para .env em desenvolvimento. Electron e Docker passam estas variáveis pelo processo.
PORT=3333
# 127.0.0.1 local/Electron; 0.0.0.0 no Docker
HOST=127.0.0.1
# Relativo à pasta prisma/ ou absoluto (recomendado em produção): file:/data/symnager.db
DATABASE_URL=file:./dev.db
# Obrigatório, >= 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,app://symnager
# true atrás de proxy reverso (nginx)
TRUST_PROXY=false
# local (Electron) | server
APP_MODE=server
# Aplica prisma/migrations no boot sem o CLI do Prisma
RUN_MIGRATIONS=true
# true quando servido via HTTPS
COOKIE_SECURE=false
